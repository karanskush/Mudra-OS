# Exclude all backend Go code except the Vercel-compatible API files
api/internal/
api/cmd/
api/main.go
api/pkg/

# Proto files and generated gRPC code
api/*.pb.go
api/*_grpc.pb.go
api/proto/
api/proto/gen/

# Go module files (not needed for frontend deployment)
api/go.mod
api/go.sum

# Backend configuration and deployment files
api/configs/
api/deployments/
api/scripts/
api/docs/

# Test files
api/test_*.go
api/*_test.go

# Other backend artifacts
api/Makefile
api/GRPC_*.md
api/LEDGER_*.md
api/KYC_*.md
api/NEON_*.md
api/BIDIRECTIONAL_*.md
api/QUICK_TEST.md
api/STARTUP_*.md
api/COMBINED_*.md
api/Implementing*.pdf

# Exclude specific API files that have dependencies on internal packages
api/api/health.go
api/api/kyc.go
api/api/ledger.go
api/api/auth.go
api/api/grpc_bridge.go
api/api/accounts.go
api/api/users.go
api/api/swagger/
api/api/v1/ 