{
  "builds": [
    {
      "src": "api/api/index.go",
      "use": "@vercel/go"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api/index.go"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
