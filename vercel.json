{
  "builds": [
    {
      "src": "api/api/index.go",
      "use": "@vercel/go",
      "config": { "maxLambdaSize": "15mb" }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/api/index.go"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "LOG_LEVEL": "info",
    "LOG_FORMAT": "json"
  }
}
