{
  "functions": {
    "backend/api/**/*.go": {
      "runtime": "vercel-go@1.0.0"
    }
  },
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api/$1"
    },
    {
      "source": "/health",
      "destination": "/backend/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "ENVIRONMENT": "production"
  }
} 