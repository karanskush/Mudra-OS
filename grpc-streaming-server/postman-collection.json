            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": {\n    \"createTransaction\": {\n      \"fromAccountId\": \"acc_business_001\",\n      \"toAccountId\": \"acc_personal_001\",\n      \"amount\": 1000,\n      \"currency\": \"USD\",\n      \"description\": \"Business to personal transfer\",\n      \"reference\": \"TXN_DEMO_001\",\n      \"metadata\": {\n        \"category\": \"transfer\",\n        \"source\": \"postman\",\n        \"department\": \"finance\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grpc/ledger/command",
