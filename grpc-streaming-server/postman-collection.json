    {
      "name": "Streaming Endpoints",
      "item": [
        {
          "name": "Payment Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/grpc/payment/stream?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "payment", "stream"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Real-time payment events stream. Keep this request open to see live updates."
          },
          "response": []
        },
        {
          "name": "KYC Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/grpc/kyc/stream?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "kyc", "stream"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Real-time KYC verification events stream. Keep this request open to see live updates."
          },
          "response": []
        },
        {
          "name": "Ledger Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/grpc/ledger/stream?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "ledger", "stream"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Real-time ledger events stream including balance updates. Keep this request open to see live updates."
          },
          "response": []
        },
        {
          "name": "Risk Monitoring Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/grpc/risk/stream?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "risk", "stream"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Real-time risk monitoring events stream. Keep this request open to see live updates."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payment Commands",
      "item": [
        {
          "name": "Initiate Payment - ACH",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": {\n    \"initiatePayment\": {\n      \"userId\": \"{{userId}}\",\n      \"fromAccountId\": \"acc_sender_001\",\n      \"toAccountId\": \"acc_receiver_001\",\n      \"amount\": 1500,\n      \"currency\": \"USD\",\n      \"description\": \"ACH payment demo\",\n      \"reference\": \"PAY_ACH_001\",\n      \"preferredRail\": \"ACH\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grpc/payment/command",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "payment", "command"]
            }
          },
          "response": []
        },
        {
          "name": "Initiate Payment - UPI",
