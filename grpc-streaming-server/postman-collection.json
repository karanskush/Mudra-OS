              "raw": "{\n  \"command\": {\n    \"uploadDocument\": {\n      \"userId\": \"{{userId}}\",\n      \"documentType\": \"passport\",\n      \"documentData\": \"base64_encoded_passport_image_data_would_go_here\",\n      \"fileName\": \"passport.jpg\"\n    }\n  }\n}"
