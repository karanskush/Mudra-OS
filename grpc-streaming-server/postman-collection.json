              "raw": "{\n  \"command\": {\n    \"initiatePayment\": {\n      \"userId\": \"{{userId}}\",\n      \"fromAccountId\": \"acc_sender_002\",\n      \"toAccountId\": \"acc_receiver_002\",\n      \"amount\": 2500,\n      \"currency\": \"INR\",\n      \"description\": \"UPI instant payment\",\n      \"reference\": \"PAY_UPI_001\",\n      \"preferredRail\": \"UPI\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/grpc/payment/command",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grpc", "payment", "command"]
            }
          },
          "response": []
