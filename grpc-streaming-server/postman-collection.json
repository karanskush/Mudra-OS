                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": {\n    \"initiatePayment\": {\n      \"userId\": \"{{userId}}\",\n      \"fromAccountId\": \"acc_sender_003\",\n      \"toAccountId\": \"acc_receiver_003\",\n      \"amount\": 3500,\n      \"currency\": \"EUR\",\n      \"description\": \"SEPA payment to Europe\",\n      \"reference\": \"PAY_SEPA_001\",\n      \"preferredRail\": \"SEPA\"\n    }\n  }\n}"
