{
  "functions": {
    "api/**/*.go": {
      "runtime": "vercel-go@1.0.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/health",
      "dest": "/api/health"
    },
    {
      "src": "/(.*)",
      "dest": "/api/$1"
    }
  ],
  "env": {
    "ENVIRONMENT": "production"
  }
} 