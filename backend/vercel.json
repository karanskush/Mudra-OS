{
  "functions": {
    "api/**/*.go": {
      "runtime": "vercel-go@1.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ],
  "env": {
    "ENVIRONMENT": "production"
  }
} 